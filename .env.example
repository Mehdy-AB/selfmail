# Resend — https://resend.com
RESEND_API_KEY=re_your_api_key_here
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Supabase — https://supabase.com
# Find all three values at: Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Secret key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# Auth — strongly recommended: set this to restrict access to a single email address.
# If unset, any person who can receive a magic link from your Supabase project can sign in.
ALLOWED_EMAIL=you@example.com

# Mailboxes — every address this app sends and receives on, all served by the
# single RESEND_API_KEY above — are managed in the app itself: sidebar →
# Mailboxes → the gear icon. Nothing to set here.

# Fallback display name for mailboxes saved without one.
FROM_NAME=Your Name

# Optional one-time import. If the mailboxes table is empty, these entries are
# inserted as real mailboxes on first use, then the table takes over and this is
# ignored. Only useful when upgrading a deployment that already used it.
# Format: `Name <address>` or a bare `address`; quote a name containing a comma.
# NEXT_PUBLIC_MAIL_ACCOUNTS=Support <support@yourdomain.com>,hello@otherdomain.com

# Deprecated — same one-time import, read only if NEXT_PUBLIC_MAIL_ACCOUNTS is unset.
# NEXT_PUBLIC_FROM_ADDRESSES=you@yourdomain.com,hello@yourdomain.com

# Optional: send inbound mail addressed to something other than a configured
# mailbox straight to Trash. Useful when a domain is set up as a catch-all.
# MAILBOX_STRICT=true

# App branding — your domain shown in the UI header and splash screen
NEXT_PUBLIC_APP_DOMAIN=yourdomain.com

# Optional: shared secret for the daily /api/keepalive cron (Vercel sends it as
# `Authorization: Bearer $CRON_SECRET`). Unset leaves the endpoint public.
# CRON_SECRET=any_long_random_string

# Optional: comma-separated domains or addresses to silently archive as spam
# BLOCKED_SENDERS=spam.com,noreply@junk.io
